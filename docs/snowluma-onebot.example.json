{
  "networks": {
    "httpServers": [
      {
        "name": "http-default",
        "enabled": true,
        "host": "0.0.0.0",
        "port": 3000,
        "path": "/",
        "accessToken": "replace-with-api-token",
        "messageFormat": "array",
        "reportSelfMessage": false
      }
    ],
    "httpClients": [
      {
        "name": "atriplus-chat-service",
        "enabled": true,
        "url": "http://host.docker.internal:8080/onebot/v11/events",
        "accessToken": "replace-with-webhook-token",
        "messageFormat": "array",
        "reportSelfMessage": false,
        "timeoutMs": 5000
      }
    ],
    "wsServers": [],
    "wsClients": []
  },
  "musicSignUrl": ""
}
